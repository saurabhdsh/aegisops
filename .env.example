APP_NAME=AegisOps
APP_ENV=development
EXECUTION_MODE=SANDBOX

# Required. At least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=

DATABASE_URL=sqlite:///./aegisops.db

# Optional local bootstrap. Used once, only when the user table is empty.
# Leave blank to start without a user. Never commit real values.
BOOTSTRAP_TENANT_SLUG=default
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# OpenAI. Leave the provider as openai, or set azure and the resource endpoint.
# Azure uses the deployment name as OPENAI_MODEL and sends the key in the api-key header.
OPENAI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENAI_API_VERSION=2024-10-21

SERVICENOW_INSTANCE_URL=
SERVICENOW_AUTH_MODE=oauth
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_ACCESS_TOKEN=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
SERVICENOW_WEBHOOK_SECRET=

DYNATRACE_ENVIRONMENT_URL=
DYNATRACE_API_TOKEN=
DYNATRACE_WEBHOOK_SECRET=

ANSIBLE_INVENTORY_PATH=
ANSIBLE_RUNBOOK_PATH=runbooks
ANSIBLE_AUTOMATION_ENDPOINT=

AUTONOMY_DEFAULT_LEVEL=L3
AUTONOMY_L4_ENABLED=false

AUDIT_ENABLED=true
OTEL_ENABLED=true

CORS_ORIGINS=http://localhost:5173
SESSION_TTL_SECONDS=43200
RATE_LIMIT_PER_MINUTE=120
SSE_POLL_SECONDS=1
# 0 means stream until the client disconnects.
SSE_MAX_POLLS=0
LOG_LEVEL=INFO
